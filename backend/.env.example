# Local model settings; real keys belong only in backend/.env or the hosting platform.
# For Qwen variables, see model-profiles.env.example.
PARSER_PROFILE=doubao
DOUBAO_API_KEY=
DOUBAO_ENDPOINT=

# Comma-separated browser origins allowed to use /parse-test directly.
# In production, add your frontend's HTTPS origin.
ALLOWED_ORIGINS=http://localhost:3000
MAX_PARSE_PAGES=10
