# Copy only the variables you need into backend/.env. Never put real keys here.
# If PARSER_PROFILE is omitted, the existing Doubao configuration remains active.

# Change only this value when switching the model under test.
PARSER_PROFILE=doubao

# Existing production/default model. Keep your current values in backend/.env.
DOUBAO_API_KEY=
DOUBAO_ENDPOINT=

# Qwen model 1 — use the DashScope/apiHost URL, NOT openAiCompatible.
# Example: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_OCR_API_KEY=
QWEN_OCR_API_HOST=
QWEN_OCR_MODEL=
QWEN_OCR_WORKSPACE_ID=

# Qwen model 2 — these may be the same key/host/workspace as Qwen OCR.
QWEN_FLASH_API_KEY=
QWEN_FLASH_API_HOST=
QWEN_FLASH_MODEL=
QWEN_FLASH_WORKSPACE_ID=
